{
  "name": "vue-webxr-starter",
  "version": "0.1.0",
  "private": true,
  "description": "A starter kit for building WebXR mixed reality apps with Vue, TresJS and Three.js on Meta Quest 3 and Android XR.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:usb": "HTTP=1 vite",
    "device": "./scripts/open-on-device.sh",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@tresjs/core": "^5.8.3",
    "@tresjs/rapier": "1.2.0",
    "three": "~0.172.0",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-mkcert": "^2.1.0",
    "vue-tsc": "^3.3.5"
  }
}
